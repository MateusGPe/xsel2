---
import CodeCard from './CodeCard.astro';

interface Props {
  leftTitle: string;
  rightTitle: string;
  leftCode: string;
  rightCode: string;
  leftLang?: string;
  rightLang?: string;
  leftAccent?: 'amber' | 'blue';
}

const {
  leftTitle,
  rightTitle,
  leftCode,
  rightCode,
  leftLang = 'bash',
  rightLang = 'json',
  leftAccent = 'blue',
} = Astro.props;
---

<div class="xsel-io-grid">
  <CodeCard
    code={leftCode}
    lang={leftLang}
    dot={leftAccent === 'blue' ? 'blue' : 'amber'}
    variant={leftAccent === 'blue' ? 'accent' : 'default'}
  >
    <Fragment slot="title">{leftTitle}</Fragment>
  </CodeCard>

  <CodeCard code={rightCode} lang={rightLang} dot="green" variant="out">
    <Fragment slot="title">{rightTitle}</Fragment>
  </CodeCard>
</div>
