</body>
</html>`,
      dsl: `let title_sel = "h1.product-title"

product = Scraper()
  .select(title_sel).text().squish().set("title")
  .select(".price").text().regex_extract("([0-9]+\\\\.[0-9]+)", 1).set("price")
  .select(".badge").text().trim().set("badges")
  .select("script").text().js_block("window.__PRODUCT_STATE__ =").parse_js("state", true)

summary = Scraper()
  .select(title_sel).text().squish().set("title")
  .select("script").text().js_block("window.__PRODUCT_STATE__ =").parse_js("state", true)
  .jmespath("{title: title, sku: state.sku, rating: state.rating}")`,
    },
    table_data: {
      cmd: 'xsel2 -d table.dsl -n market_summary --html table.html',
      html: `<div class="market-board">
  <header>
    <h1>Tech &amp; Semiconductor Index</h1>
    <span class="timestamp" data-epoch="1774300800">Last updated: 2026-03-23 16:00 EST</span>
  </header>
  <table class="financial-matrix" data-exchange="NASDAQ">
    <thead>
      <tr>
        <th>Ticker</th><th>Company</th><th>Price</th><th>Change</th><th>Market Cap</th><th>Rating</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="symbol">NVDA</td><td>NVIDIA Corporation</td><td>$145.80</td><td class="positive">+3.45%</td><td>$3.58T</td><td>Strong Buy</td>
      </tr>
      <tr>
        <td class="symbol">AAPL</td><td>Apple Inc.</td><td>$228.50</td><td class="positive">+0.82%</td><td>$3.47T</td><td>Buy</td>
      </tr>
      <tr>
        <td class="symbol">MSFT</td><td>Microsoft Corp.</td><td>$422.15</td><td class="negative">-0.35%</td><td>$3.14T</td><td>Buy</td>
      </tr>
      <tr>
        <td class="symbol">INTC</td><td>Intel Corporation</td><td>$24.10</td><td class="negative">-2.10%</td><td>$105.4B</td><td>Hold</td>
      </tr>
    </tbody>
