---
interface Props {
  fullPage?: boolean;
}

const { fullPage = false } = Astro.props;
const rawBase = import.meta.env.BASE_URL || '/';
const baseUrl = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<div class:list={['xsel-pg', { 'xsel-pg--full': fullPage }]} data-base-url={baseUrl}>
  <div class="xsel-pg__toolbar">
    <div class="xsel-pg__toolbar-left">
      <label class="xsel-pg__label">
        <span>Preset</span>
        <select class="xsel-pg__select" data-role="preset">
          <option value="card">30-Second Product Card (DSL)</option>
          <option value="product">Product + JMESPath Summary (DSL)</option>
          <option value="table_data">HTML Table &amp; Financial Matrix (DSL)</option>
          <option value="ecommerce_catalog">E-Commerce Catalog &amp; Variants (DSL)</option>
          <option value="article_news">News Article &amp; JSON-LD Schema (DSL)</option>
          <option value="social_hydration">Social Media &amp; JS Hydration (DSL)</option>
          <option value="selector">Quick CSS Selector (-s)</option>
          <option value="js_digger">JS Block &amp; JSON Digger (DSL)</option>
        </select>
      </label>
      <label class="xsel-pg__check">
        <input type="checkbox" data-role="compact" />
        <span>Compact (<code>-c</code>)</span>
      </label>
    </div>
    <div class="xsel-pg__toolbar-right">
      <span class="xsel-pg__status" data-role="status">WASM: Ready on run</span>
      <button type="button" class="xsel-pg__btn" data-role="run">
        Run in WASM
      </button>
    </div>
  </div>

  <div class="xsel-pg__cli">
    <span class="xsel-pg__prompt">$</span>
    <input
      type="text"
      class="xsel-pg__cmd"
      data-role="cmd"
      spellcheck="false"
      aria-label="xsel2 CLI command"
      value="xsel2 -d card.dsl -n product --html card.html"
    />
  </div>

  <div class="xsel-pg__grid">
    <div class="xsel-pg__pane">
      <div class="xsel-pg__pane-head">
        <span>HTML Input</span>
      </div>
      <div class="xsel-pg__cm" data-role="html"></div>
    </div>

    <div class="xsel-pg__pane">
      <div class="xsel-pg__pane-head">
        <span>DSL Pipeline (<code>.dsl</code>)</span>
      </div>
      <div class="xsel-pg__cm" data-role="dsl"></div>
    </div>

    <div class="xsel-pg__pane xsel-pg__pane--out">
      <div class="xsel-pg__pane-head">
        <span>JSON Output</span>
      </div>
      <div class="xsel-pg__cm" data-role="output"></div>
    </div>
  </div>
</div>

<script>
  import { createPlaygroundEditors } from './xsel2-codemirror.ts';

  const PRESETS = {
    card: {
      cmd: 'xsel2 -d card.dsl -n product --html card.html',
      html: `<article class="product-card">
  <h1 class="title">  Mechanical   Keyboard   Pro  </h1>
  <span class="price">$1,299.50</span>
  <img class="hero" src="/img/placeholder.png" data-src="/img/mk-pro.webp" />
  <a class="manual" href="/docs/mk-pro.pdf">User Manual</a>
  <dl class="specs">
    <dt>Switch</dt><dd>Tactile Brown</dd>
    <dt>Layout</dt><dd>75% Compact</dd>
  </dl>
  <script>
    window.__STATE__ = {
      sku: "MK-75", // unquoted keys & comments
      rating: 4.8,
      inStock: true,
    };
  <\/script>
</article>`,
      dsl: `let base = "https://shop.example"
product = Scraper()
  .$("article.product-card") {
    find("h1.title") | clean -> "title"
    | find(".price") | to_number(key="price")
    | find("img.hero", Attribute, ["data-src", "src"]) | url_join(base) -> "image"
    | find("a.manual", Attribute, "href") | url_join(base) -> "manual_url"
    | find_all("dl.specs dt") | clean -> "_k"
    | find_all("dl.specs dd") | clean -> "_v"
    | zip_keys("_k", "_v", "specs") | omit_keys(["_k", "_v"])
  }
  .$("script") { text | js_block("window.__STATE__ =") | parse_js("state") }`,
    },
    product: {
      cmd: 'xsel2 -d product.dsl -n summary --html sample.html',
      html: `<!DOCTYPE html>
<html lang="en">
<body>
  <main class="product-page">
    <h1 class="product-title">  Mechanical   Keyboard   Pro  </h1>
    <div class="pricing">
      <span class="price" data-currency="USD">$149.99</span>
      <span class="badge">In Stock</span>
      <span class="badge">Free Shipping</span>
    </div>
    <ul class="specs">
      <li>Switch: Tactile Brown</li>
      <li>Layout: 75% Compact</li>
