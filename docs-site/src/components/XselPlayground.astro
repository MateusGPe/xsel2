  | jmespath("{index: index_title, updated_epoch: epoch, buy_recommendations: stocks[?rating == 'Strong Buy' || rating == 'Buy'].{symbol: ticker, company: company, price: price, change: change, market_cap: market_cap}}")`,
    },
    ecommerce_catalog: {
      cmd: 'xsel2 -d catalog.dsl -n catalog --html catalog.html',
      html: `<div class="catalog-grid">
  <div class="product-item" data-id="p-101" data-available="true">
    <h3 class="name">Titanium Wireless Earbuds</h3>
    <span class="price" data-usd="129.00">$129.00</span>
    <span class="badge in-stock">In Stock</span>
    <span class="badge promo">Save 15%</span>
    <div class="variants">
      <span class="color" data-color="Space Gray" data-sku="TWE-SG">Space Gray</span>
      <span class="color" data-color="Matte Black" data-sku="TWE-MB">Matte Black</span>
    </div>
    <a class="p-link" href="/products/titanium-earbuds">View Product</a>
  </div>
  <div class="product-item" data-id="p-102" data-available="false">
    <h3 class="name">ANC Over-Ear Studio Headphones</h3>
    <span class="price" data-usd="249.50">$249.50</span>
    <span class="badge out-of-stock">Backorder</span>
    <div class="variants">
      <span class="color" data-color="Midnight Blue" data-sku="ANC-BL">Midnight Blue</span>
    </div>
    <a class="p-link" href="/products/anc-studio">View Product</a>
  </div>
  <nav class="pagination">
    <span class="current">Page 1 of 12</span>
    <a class="next-page" href="/catalog?page=2">Next Page &raquo;</a>
  </nav>
</div>`,
      dsl: `let origin = "https://audiohub.example"

catalog = Scraper()
  | $("div.product-item", "items") {
      @"data-id" -> "product_id"
      | @"data-available" | to_bool(key="available")
      | find("h3.name") | clean -> "name"
      | find(".price", Attribute, "data-usd") | to_float(key="price_usd")
      | find_all(".badge") | clean -> "badges"
      | find_all(".variants .color", Attribute, "data-color") -> "available_colors"
      | find_all(".variants .color", Attribute, "data-sku") -> "variant_skus"
      | find("a.p-link", Attribute, "href") | url_join(origin) -> "url"
    }
  | $("nav.pagination") {
      find("span.current") | clean -> "page_status"
      | find("a.next-page", Attribute, "href") | url_join(origin) -> "next_page_url"
    }`,
    },
    article_news: {
      cmd: 'xsel2 -d article.dsl -n article --html article.html',
      html: `<article class="post-entry">
  <header class="post-header">
    <nav class="breadcrumbs">
      <a href="/category/tech">Technology</a> &gt; <a href="/category/systems">Systems Engineering</a>
    </nav>
    <h1 class="headline">Building Ultra-Fast Native Web Scrapers with C++20</h1>
    <div class="byline">
      <span class="author" data-author-id="dev-42">Sarah Connor</span>
      <time class="pub-date" datetime="2026-11-20T14:30:00Z">Nov 20, 2026</time>
      <span class="read-time">6 min read</span>
    </div>
  </header>
  <div class="post-body">
    <p class="lead">By streaming HTML directly into compiled libxml2 DOM buffers, we eliminate V8 execution overhead.</p>
    <p>Declarative pipeline engines allow developers to express data normalization without maintaining fragile regex soups.</p>
  </div>
  <footer class="post-tags">
    <a class="tag" href="/tags/cpp">#cpp</a>
    <a class="tag" href="/tags/scraping">#scraping</a>
    <a class="tag" href="/tags/performance">#performance</a>
  </footer>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "headline": "Building Ultra-Fast Native Web Scrapers with C++20",
      "author": { "@type": "Person", "name": "Sarah Connor" },
      "datePublished": "2026-11-20T14:30:00Z",
      "wordCount": 1420
    }
  <\/script>
</article>`,
      dsl: `let site_base = "https://techpulse.dev"

article = Scraper()
  .$("article.post-entry") {
    find("h1.headline") | clean -> "title"
    | find(".byline .author") | clean -> "author"
    | find(".byline time.pub-date", Attribute, "datetime") -> "published_at"
    | find(".byline .read-time") | clean -> "reading_time"
    | find_all("nav.breadcrumbs a") | clean -> "breadcrumbs"
    | find_all(".post-tags a.tag") | clean -> "tags"
    | find(".post-body p.lead") | clean -> "summary"
  }
  .$("script[type='application/ld+json']") {
    text | json_parse("json_ld", strict=false)
  }
  | omit_keys(["json_ld.@context"])`,
    },
    social_hydration: {
      cmd: 'xsel2 -d social.dsl -n social --html social.html',
      html: `<main id="app-root">
  <div class="post-card" data-post-id="status_9921">
    <div class="author-row">
      <span class="handle">@linus_torvalds</span>
      <span class="badge verified">Verified</span>
    </div>
    <p class="content">Talk is cheap. Show me the code.</p>
    <div class="engagement">
      <span class="likes" data-count="14820">14.8K Likes</span>
      <span class="reposts" data-count="3210">3.2K Reposts</span>
    </div>
  </div>
  <script>
    window.__INITIAL_DATA__ = {
      threadId: "status_9921",
      author: {
        userId: "u-1001",
        username: "linus_torvalds",
        followers: 1250000,
        isSponsor: true
      },
      comments: [
        { id: "c-1", user: "dev_alex", score: 45, text: "Classic quote!" },
        { id: "c-2", user: "code_ninja", score: 89, text: "Still relevant in 2026." },
        { id: "c-3", user: "rustacean", score: 112, text: "Borrow checker approved." }
      ],
      metrics: { views: 89000, impressions: 142000 }
    };
  <\/script>
</main>`,
      dsl: `social = Scraper()
  .$(".post-card") {
    find(".author-row .handle") | clean -> "author_handle"
    | find(".content") | clean -> "post_text"
    | find(".engagement .likes", Attribute, "data-count") | to_number(key="likes_count")
    | find(".engagement .reposts", Attribute, "data-count") | to_number(key="reposts_count")
  }
  .$("script") {
    text | js_block("window.__INITIAL_DATA__ =") | parse_js("payload", true)
  }
  | jmespath("{author: payload.author.username, followers: payload.author.followers, post: post_text, likes: likes_count, top_comments: payload.comments[?score > \`50\`].{user: user, score: score, text: text}}")`,
    },
    selector: {
      cmd: 'xsel2 -s "ul.specs li" --html sample.html',
      html: `<ul class="specs">
  <li>  Switch:   Tactile Brown  </li>
  <li>  Layout:   75% Compact  </li>
  <li>  Connection: USB-C / Bluetooth  </li>
</ul>`,
      dsl: `// Quick selector mode (-s) ignores the .dsl buffer.\n// Edit the CLI command above to test any CSS selector!`,
    },
    js_digger: {
      cmd: 'xsel2 -d digger.dsl --html page.html',
      html: `<script>
  window.__HYDRATION__ = {
    store: 'Apex ' + 'Audio', // string concat & single quotes
    featured: [
      { id: 101, name: "Studio Monitor", price: 199.90, },
      { id: 102, name: "Braided Cable", price: 29.50, }
    ],
    active: true,
  };
<\/script>`,
      dsl: `hydration = Scraper()
  .$("script") {
    text
    | js_block("window.__HYDRATION__ =")
    | parse_js("data", true)
  }
  | jmespath("data.featured[?price > \`50\`].{id: id, name: name, price: price}")`,
    },
  };

  let modulePromise = null;

  async function getWasmModule(baseUrl) {
    if (!modulePromise) {
      const wasmJsUrl = `${baseUrl}wasm/xsel2.js`;
      modulePromise = import(/* @vite-ignore */ wasmJsUrl).then((mod) =>
        mod.default({
          locateFile: (path) => `${baseUrl}wasm/${path}`,
        })
      );
    }
    return modulePromise;
  }

  function initPlayground(root) {
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const baseUrl = root.dataset.baseUrl || '/';
    const presetEl = root.querySelector('[data-role="preset"]');
    const compactEl = root.querySelector('[data-role="compact"]');
    const cmdEl = root.querySelector('[data-role="cmd"]');
    const htmlHost = root.querySelector('[data-role="html"]');
    const dslHost = root.querySelector('[data-role="dsl"]');
    const outHost = root.querySelector('[data-role="output"]');
    const statusEl = root.querySelector('[data-role="status"]');
    const runBtn = root.querySelector('[data-role="run"]');

    let editors;

    function loadPreset(key) {
      const preset = PRESETS[key] || PRESETS.card;
      cmdEl.value = preset.cmd;
      editors.setHtml(preset.html);
      editors.setDsl(preset.dsl);
    }

    async function execute() {
      runBtn.disabled = true;
      statusEl.textContent = 'Running in WASM...';
      statusEl.dataset.state = 'busy';

      try {
        const mod = await getWasmModule(baseUrl);
        let cmd = cmdEl.value.trim();
        if (compactEl.checked && !/(?:^|\s)(-c|--compact)(?:\s|$)/.test(cmd)) {
          cmd = `${cmd} -c`;
        }
        const raw = mod.run_cli(cmd, editors.getHtml(), editors.getDsl());
        const res = JSON.parse(raw);

        if (res.ok) {
          editors.setOutput(res.stdout, false);
          statusEl.textContent = `WASM: ${res.elapsedMs.toFixed(2)} ms`;
          statusEl.dataset.state = 'ok';
        } else {
          editors.setOutput(res.stderr || 'Unknown error', true);
          statusEl.textContent = `Error (${res.elapsedMs.toFixed(2)} ms)`;
          statusEl.dataset.state = 'err';
        }
      } catch (err) {
        editors.setOutput(String(err), true);
        statusEl.textContent = 'WASM load failed';
        statusEl.dataset.state = 'err';
      } finally {
        runBtn.disabled = false;
      }
    }

    editors = createPlaygroundEditors(htmlHost, dslHost, outHost, execute);

    presetEl.addEventListener('change', () => {
      loadPreset(presetEl.value);
      execute();
    });

    compactEl.addEventListener('change', execute);
    runBtn.addEventListener('click', execute);
    cmdEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        execute();
      }
    });

    loadPreset('card');
    execute();
  }

  document.querySelectorAll('.xsel-pg').forEach(initPlayground);
</script>

<style>
  .xsel-pg {
    container-type: inline-size;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.65rem;
    background: var(--sl-color-bg-nav);
    overflow: hidden;
    margin: 1rem 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  }

  :global(.xsel-pg .cm-editor) {
    line-height: 1.35 !important;
  }

  :global(.xsel-pg .cm-scroller) {
    line-height: 1.35 !important;
  }

  :global(.xsel-pg .cm-line) {
    line-height: 1.35 !important;
    padding-top: 1px !important;
    padding-bottom: 1px !important;
  }

  :global(.xsel-pg .cm-content) {
    line-height: 1.35 !important;
    padding: 4px 0 !important;
  }

  :global(.xsel-pg .cm-gutters) {
    line-height: 1.35 !important;
  }

  :global(.xsel-pg .cm-gutterElement) {
    line-height: 1.35 !important;
  }

  .xsel-pg__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-sidebar);
  }

  .xsel-pg__toolbar-left,
  .xsel-pg__toolbar-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .xsel-pg__label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .xsel-pg__select {
    padding: 0.25rem 0.55rem;
    border-radius: 0.35rem;
    border: 1px solid var(--sl-color-gray-4);
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-size: 0.82rem;
  }

  .xsel-pg__check {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.82rem;
    cursor: pointer;
  }

  .xsel-pg__status {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
  }

  .xsel-pg__status[data-state='ok'] {
    color: #22c55e;
  }

  .xsel-pg__status[data-state='err'] {
    color: #ef4444;
  }

  .xsel-pg__btn {
    padding: 0.35rem 0.8rem;
    border: none;
    border-radius: 0.4rem;
    background: var(--sl-accent);
    color: #fff;
    font-weight: 600;
    font-size: 0.82rem;
    cursor: pointer;
  }

  .xsel-pg__btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .xsel-pg__cli {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    font-family: var(--sl-font-mono);
  }

  .xsel-pg__prompt {
    color: var(--sl-accent);
    font-weight: 700;
  }

  .xsel-pg__cmd {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--sl-color-text);
    font-family: var(--sl-font-mono);
    font-size: 0.84rem;
    outline: none;
  }

  .xsel-pg__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    min-height: 360px;
  }

  .xsel-pg--full .xsel-pg__grid {
    min-height: 500px;
  }

  @container (max-width: 900px) {
    .xsel-pg__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .xsel-pg__pane:nth-child(2) {
      border-right: none;
    }

    .xsel-pg__pane--out {
      grid-column: 1 / -1;
      border-right: none;
      border-top: 1px solid var(--sl-color-gray-5);
    }

    .xsel-pg--full .xsel-pg__pane--out .xsel-pg__cm {
      height: 300px;
      min-height: 260px;
    }
  }

  @container (max-width: 600px) {
    .xsel-pg__grid {
      grid-template-columns: 1fr;
    }

    .xsel-pg__pane {
      border-right: none;
      border-bottom: 1px solid var(--sl-color-gray-5);
    }

    .xsel-pg__pane--out {
      border-top: none;
      border-bottom: none;
    }
  }

  .xsel-pg__pane {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--sl-color-gray-5);
    min-width: 0;
  }

  .xsel-pg__pane:last-child {
    border-right: none;
  }

  .xsel-pg__pane-head {
    padding: 0.32rem 0.75rem;
    font-size: 0.74rem;
    font-weight: 600;
