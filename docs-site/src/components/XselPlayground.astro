---
import syncedExamples from '../data/synced-examples.json';

interface Props {
  fullPage?: boolean;
  compact?: boolean;
  initialPreset?: string;
}

const { fullPage = false, compact = false, initialPreset = 'card' } = Astro.props;
const rawBase = import.meta.env.BASE_URL || '/';
const baseUrl = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const EXCLUSIVE_PRESET_LABELS = [
  { id: 'card', label: 'Product Card' },
  { id: 'js_digger', label: 'JS Block Digger' },
  { id: 'table', label: 'HTML Table -> JSON' },
  { id: 'aho', label: 'Aho-Corasick Filter' },
  { id: 'product', label: 'JMESPath Summary' },
  { id: 'selector', label: 'Quick CSS (-s)' },
];

const syncedPresets = syncedExamples?.presets ?? {};
const exclusiveIds = new Set(EXCLUSIVE_PRESET_LABELS.map((p) => p.id));
const SYNCED_PRESET_LABELS = Object.values(syncedPresets)
  .filter((p) => !exclusiveIds.has(p.id))
  .map((p) => ({ id: p.id, label: p.label }));

const COMPACT_PRESET_LABELS = EXCLUSIVE_PRESET_LABELS.some((p) => p.id === initialPreset)
  ? EXCLUSIVE_PRESET_LABELS
  : [
      ...EXCLUSIVE_PRESET_LABELS,
      ...SYNCED_PRESET_LABELS.filter((p) => p.id === initialPreset),
    ];

const PRESET_LABELS = compact
  ? COMPACT_PRESET_LABELS
  : [...EXCLUSIVE_PRESET_LABELS, ...SYNCED_PRESET_LABELS];
const serializedSyncedPresets = JSON.stringify(syncedPresets).replace(/</g, '\\u003c');
---

<div
  class:list={['xsel-pg', 'not-content', { 'xsel-pg--full': fullPage, 'xsel-pg--compact': compact }]}
  data-base-url={baseUrl}
  data-initial-preset={initialPreset}
>
  <div class="xsel-pg__toolbar">
    <div class="xsel-pg__toolbar-left">
      <div class="xsel-pg__pills" role="group" aria-label="Playground presets">
        {
          PRESET_LABELS.map((p) => (
            <button
              type="button"
              class="xsel-pg__pill"
              data-role="preset-btn"
              data-preset={p.id}
              aria-pressed={p.id === initialPreset ? 'true' : 'false'}
            >
              {p.label}
            </button>
          ))
        }
      </div>
      <label class="xsel-pg__check">
        <input type="checkbox" data-role="compact" />
        <span>Compact (<code>-c</code>)</span>
      </label>
    </div>
    <div class="xsel-pg__toolbar-right">
      <span class="xsel-pg__status" data-role="status">WASM: Ready</span>
      <button type="button" class="xsel-pg__btn" data-role="run">
        Run in WASM
      </button>
    </div>
  </div>

  <div class="xsel-pg__cli">
    <span class="xsel-pg__prompt">$</span>
    <input
      type="text"
      class="xsel-pg__cmd"
      data-role="cmd"
      spellcheck="false"
      aria-label="xsel2 CLI command"
      value="xsel2 -d card.dsl -n product --html card.html"
    />
  </div>

  <div class="xsel-pg__grid">
    <div class="xsel-pg__pane">
      <div class="xsel-pg__pane-head">
        <span>HTML Input</span>
      </div>
      <div class="xsel-pg__cm" data-role="html"></div>
    </div>

    <div class="xsel-pg__pane">
      <div class="xsel-pg__pane-head">
        <span><code>xsel2</code> DSL (<code>.dsl</code>)</span>
      </div>
      <div class="xsel-pg__cm" data-role="dsl"></div>
    </div>

    <div class="xsel-pg__pane xsel-pg__pane--out">
      <div class="xsel-pg__pane-head xsel-pg__pane-head--out">
        <span>JSON Output</span>
        <button type="button" class="xsel-pg__copy" data-role="copy-out">Copy JSON</button>
      </div>
      <div class="xsel-pg__cm" data-role="output"></div>
    </div>
  </div>
  <script type="application/json" data-role="synced-presets" set:html={serializedSyncedPresets}></script>
</div>

<script>
  import { createPlaygroundEditors } from './xsel2-codemirror.ts';

  const PRESETS = {
    card: {
      cmd: 'xsel2 -d card.dsl -n product --html card.html',
      html: `<article class="product-card">
  <h1 class="title">  Mechanical   Keyboard   Pro  </h1>
  <span class="price">$1,299.50</span>
  <img class="hero" src="/img/placeholder.png" data-src="/img/mk-pro.webp" />
  <a class="manual" href="/docs/mk-pro.pdf">User Manual</a>
  <dl class="specs">
    <dt>Switch</dt><dd>Tactile Brown</dd>
    <dt>Layout</dt><dd>75% Compact</dd>
  </dl>
  <script>
    window.__STATE__ = {
      sku: "MK-75", // unquoted keys & comments
      rating: 4.8,
      inStock: true,
    };
  <\/script>
</article>`,
      dsl: `let base = "https://shop.example"
product = Scraper()
  .$("article.product-card") {
    find("h1.title") | clean -> "title"
    | find(".price") | to_number(key="price")
    | find("img.hero", Attribute, ["data-src", "src"]) | url_join(base) -> "image"
    | find("a.manual", Attribute, "href") | url_join(base) -> "manual_url"
    | find_all("dl.specs dt") | clean -> "_k"
    | find_all("dl.specs dd") | clean -> "_v"
    | zip_keys("_k", "_v", "specs") | omit_keys(["_k", "_v"])
  }
  .$("script") { text | js_block("window.__STATE__ =") | parse_js("state") }`,
    },
    js_digger: {
      cmd: 'xsel2 -d digger.dsl --html page.html',
      html: `<script>
  window.__HYDRATION__ = {
    store: 'Apex ' + 'Audio', // string concat & single quotes
    featured: [
      { id: 101, name: "Studio Monitor", price: 199.90, },
      { id: 102, name: "Braided Cable", price: 29.50, }
    ],
    active: true,
  };
<\/script>`,
      dsl: `hydration = Scraper()
  .$("script") {
    text
    | js_block("window.__HYDRATION__ =")
    | parse_js("data", true)
  }
  | jmespath("data.featured[?price > \`50\`].{id: id, name: name, price: price}")`,
    },
    table: {
      cmd: 'xsel2 -d table.dsl --html specs.html',
      html: `<table class="specs">
  <thead>
    <tr><th>Component</th><th>Engine / Library</th><th>Role</th></tr>
  </thead>
  <tbody>
    <tr><td>DOM &amp; XPath</td><td>libxml2 + lxml2-query</td><td>CSS &amp; XPath 1.0</td></tr>
    <tr><td>Regex</td><td>Google RE2</td><td>Linear-time matching</td></tr>
    <tr><td>JSON &amp; JMESPath</td><td>jsoncons</td><td>Shaping &amp; validation</td></tr>
  </tbody>
</table>`,
      dsl: `specs = Scraper()
  .$("table.specs") {
    table(key="rows", normalize_headers=true)
  }`,
    },
    aho: {
      cmd: 'xsel2 -d filter.dsl --html catalog.html',
      html: `<section class="catalog">
  <ul class="items">
    <li>Mechanical Keyboard Pro (C++20 Edition)</li>
    <li>Mechanical Keyboard Pro - Refurbished</li>
    <li>CMake + RE2 High-Speed Parser Kit</li>
    <li>USB-C Coiled Cable (Refurbished)</li>
  </ul>
  <article class="notes">
    Built with C++20, CMake, and Google RE2 for deterministic extraction.
  </article>
</section>`,
      dsl: `catalog = Scraper()
  .$("ul.items") {
    find_all("li", Text)
    | filter(["+Pro", "-Refurbished"])
    -> "matching_items"
  }
  .$("article.notes") {
    text
    | extract_many(["C++20", "CMake", "RE2"])
    -> "detected_tech"
  }`,
    },
    product: {
      cmd: 'xsel2 -d product.dsl -n summary --html sample.html',
      html: `<!DOCTYPE html>
<html lang="en">
<body>
  <main class="product-page">
    <h1 class="product-title">  Mechanical   Keyboard   Pro  </h1>
    <div class="pricing">
      <span class="price" data-currency="USD">$149.99</span>
      <span class="badge">In Stock</span>
      <span class="badge">Free Shipping</span>
    </div>
    <ul class="specs">
      <li>Switch: Tactile Brown</li>
      <li>Layout: 75% Compact</li>
      <li>Connection: USB-C / Bluetooth</li>
    </ul>
  </main>
  <script>
    window.__PRODUCT_STATE__ = {
      sku: "MK-PRO-75",
      rating: 4.8,
      inStock: true,
      tags: ["mechanical", "wireless", "rgb"]
    };
  <\/script>
</body>
</html>`,
      dsl: `let title_sel = "h1.product-title"

product = Scraper()
  .select(title_sel).text().squish().set("title")
  .select(".price").text().regex_extract("([0-9]+\\\\.[0-9]+)", 1).set("price")
  .select(".badge").text().trim().set("badges")
  .select("script").text().js_block("window.__PRODUCT_STATE__ =").parse_js("state", true)

summary = Scraper()
  .select(title_sel).text().squish().set("title")
  .select("script").text().js_block("window.__PRODUCT_STATE__ =").parse_js("state", true)
  .jmespath("{title: title, sku: state.sku, rating: state.rating}")`,
    },
    selector: {
      cmd: 'xsel2 -s "ul.specs li" --html sample.html',
      html: `<ul class="specs">
  <li>  Switch:   Tactile Brown  </li>
  <li>  Layout:   75% Compact  </li>
  <li>  Connection: USB-C / Bluetooth  </li>
</ul>`,
      dsl: `// Quick selector mode (-s) ignores the .dsl buffer.\n// Edit the CLI command above to test any CSS selector!`,
    },
  };

  let modulePromise = null;

  async function getWasmModule(baseUrl) {
    if (!modulePromise) {
      const wasmJsUrl = `${baseUrl}wasm/xsel2.js`;
      modulePromise = import(/* @vite-ignore */ wasmJsUrl).then((mod) =>
        mod.default({
          locateFile: (path) => `${baseUrl}wasm/${path}`,
        })
      );
    }
    return modulePromise;
  }

  function initPlayground(root) {
    if (root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const baseUrl = root.dataset.baseUrl || '/';
    const initialPreset = root.dataset.initialPreset || 'card';
    const presetBtns = root.querySelectorAll('[data-role="preset-btn"]');
    const compactEl = root.querySelector('[data-role="compact"]');
    const cmdEl = root.querySelector('[data-role="cmd"]');
    const htmlHost = root.querySelector('[data-role="html"]');
    const dslHost = root.querySelector('[data-role="dsl"]');
    const outHost = root.querySelector('[data-role="output"]');
    const statusEl = root.querySelector('[data-role="status"]');
    const runBtn = root.querySelector('[data-role="run"]');
    const copyOutBtn = root.querySelector('[data-role="copy-out"]');
    const syncedEl = root.querySelector('[data-role="synced-presets"]');
    const syncedMap = syncedEl ? JSON.parse(syncedEl.textContent || '{}') : {};
    const ALL_PRESETS = { ...syncedMap, ...PRESETS };

    let editors;
    let lastOutput = '';

    function loadPreset(key) {
      const activeKey = ALL_PRESETS[key] ? key : 'card';
      const preset = ALL_PRESETS[activeKey];
      cmdEl.value = preset.cmd;
      editors.setHtml(preset.html);
      editors.setDsl(preset.dsl);
      presetBtns.forEach((btn) => {
        btn.setAttribute('aria-pressed', btn.dataset.preset === activeKey ? 'true' : 'false');
      });
    }

    async function execute() {
      runBtn.disabled = true;
      statusEl.textContent = 'Running in WASM...';
      statusEl.dataset.state = 'busy';

      try {
        const mod = await getWasmModule(baseUrl);
        let cmd = cmdEl.value.trim();
        if (compactEl.checked && !/(?:^|\s)(-c|--compact)(?:\s|$)/.test(cmd)) {
          cmd = `${cmd} -c`;
        }
        const raw = mod.run_cli(cmd, editors.getHtml(), editors.getDsl());
        const res = JSON.parse(raw);

        if (res.ok) {
          lastOutput = res.stdout;
          editors.setOutput(res.stdout, false);
          statusEl.textContent = `WASM: ${res.elapsedMs.toFixed(2)} ms`;
          statusEl.dataset.state = 'ok';
        } else {
          lastOutput = res.stderr || 'Unknown error';
          editors.setOutput(lastOutput, true);
          statusEl.textContent = `Error (${res.elapsedMs.toFixed(2)} ms)`;
          statusEl.dataset.state = 'err';
        }
      } catch (err) {
        lastOutput = String(err);
        editors.setOutput(lastOutput, true);
        statusEl.textContent = 'WASM load failed';
        statusEl.dataset.state = 'err';
      } finally {
        runBtn.disabled = false;
      }
    }

    editors = createPlaygroundEditors(htmlHost, dslHost, outHost, execute);

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        loadPreset(btn.dataset.preset);
        execute();
      });
    });

    compactEl.addEventListener('change', execute);
    runBtn.addEventListener('click', execute);
    cmdEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        execute();
      }
    });

    copyOutBtn.addEventListener('click', async () => {
      if (!lastOutput) return;
      try {
        await navigator.clipboard.writeText(lastOutput);
        copyOutBtn.textContent = 'Copied!';
        setTimeout(() => {
          copyOutBtn.textContent = 'Copy JSON';
        }, 1500);
      } catch {
        // Ignore clipboard errors in restricted contexts
      }
    });

    loadPreset(initialPreset);
    execute();
  }

  document.querySelectorAll('.xsel-pg').forEach(initPlayground);
</script>

<style>
  .xsel-pg {
    container-type: inline-size;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.65rem;
    background: var(--sl-color-bg-nav);
    overflow: hidden;
    margin: 1rem 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  }

  :global(.xsel-pg .cm-editor) {
    font-size: 0.82rem;
    line-height: 1.4 !important;
  }

  :global(.xsel-pg .cm-scroller) {
    line-height: 1.4 !important;
  }

  :global(.xsel-pg .cm-content) {
    line-height: 1.4 !important;
    padding: 4px 0 !important;
  }

  :global(.xsel-pg .cm-line) {
    line-height: 1.4 !important;
    padding: 0 8px !important;
    margin: 0 !important;
  }

  :global(.xsel-pg .cm-gutters) {
    line-height: 1.4 !important;
    margin: 0 !important;
  }

  :global(.xsel-pg .cm-gutterElement) {
    line-height: 1.4 !important;
  }

  .xsel-pg__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-sidebar);
  }

  .xsel-pg__toolbar-left,
  .xsel-pg__toolbar-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  .xsel-pg__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .xsel-pg__pill {
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }

  .xsel-pg__pill:hover {
    border-color: var(--sl-accent);
    color: var(--sl-accent-high);
  }

  .xsel-pg__pill[aria-pressed='true'] {
    background: var(--sl-accent-low);
    border-color: var(--sl-accent);
    color: var(--sl-accent-high);
  }

  .xsel-pg__check {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    cursor: pointer;
    margin-left: 0.25rem;
  }

  .xsel-pg__status {
    font-size: 0.78rem;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
  }

  .xsel-pg__status[data-state='ok'] {
    color: var(--xsel-emerald, #10b981);
  }

  .xsel-pg__status[data-state='err'] {
    color: var(--sl-color-red-high, #ef4444);
  }

  .xsel-pg__btn {
    padding: 0.4rem 0.85rem;
    border: none;
    border-radius: 0.4rem;
    background: var(--sl-accent);
    color: #06181e;
    font-weight: 700;
    font-size: 0.82rem;
    cursor: pointer;
    min-height: 40px;
  }

  :global(:root[data-theme='light']) .xsel-pg__btn {
    background: #0e7490;
    color: #ffffff;
  }

  .xsel-pg__btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .xsel-pg__cli {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    font-family: var(--sl-font-mono);
  }

  .xsel-pg__prompt {
    color: var(--sl-accent);
    font-weight: 700;
  }

  .xsel-pg__cmd {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--sl-color-text);
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    line-height: normal;
    padding: 0;
    margin: 0;
    outline: none;
  }

  .xsel-pg__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    min-height: 340px;
  }

  .xsel-pg--full .xsel-pg__grid {
    min-height: 500px;
  }

  .xsel-pg--compact .xsel-pg__grid {
    min-height: 230px;
  }

  @container (max-width: 900px) {
    .xsel-pg__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .xsel-pg__pane:nth-child(2) {
      border-right: none;
    }

    .xsel-pg__pane--out {
      grid-column: 1 / -1;
      border-right: none;
      border-top: 1px solid var(--sl-color-gray-5);
    }

    .xsel-pg--full .xsel-pg__pane--out .xsel-pg__cm {
      height: 300px;
      min-height: 260px;
    }
  }

  @container (max-width: 600px) {
    .xsel-pg__grid {
      grid-template-columns: 1fr;
    }

    .xsel-pg__pane {
      border-right: none;
      border-bottom: 1px solid var(--sl-color-gray-5);
    }

    .xsel-pg__pane--out {
      border-top: none;
      border-bottom: none;
    }
  }

  .xsel-pg__pane {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--sl-color-gray-5);
    min-width: 0;
  }

  .xsel-pg__pane:last-child {
    border-right: none;
  }

  .xsel-pg__pane-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.42rem 0.85rem;
    font-size: 0.76rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-2);
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-sidebar);
  }

  .xsel-pg__copy {
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.14rem 0.45rem;
    border-radius: 0.3rem;
    text-transform: none;
    letter-spacing: normal;
    cursor: pointer;
  }

  .xsel-pg__copy:hover {
    border-color: var(--sl-accent);
    color: var(--sl-accent-high);
  }

  .xsel-pg__cm {
    flex: 1;
    height: 340px;
    min-height: 300px;
    overflow: hidden;
    background: var(--sl-color-bg);
  }

  .xsel-pg--full .xsel-pg__cm {
    height: 480px;
    min-height: 440px;
  }

  .xsel-pg--compact .xsel-pg__cm {
    height: 230px;
    min-height: 210px;
  }

  .xsel-pg__cm[data-error='true'] :global(.cm-content) {
    color: var(--sl-color-red-high, #ef4444);
  }

  @media (max-width: 48rem) {
    .xsel-pg__pill,
    .xsel-pg__copy {
      min-height: 40px;
      min-width: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.4rem 0.75rem;
    }
  }
</style>
