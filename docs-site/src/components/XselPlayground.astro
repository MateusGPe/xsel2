</div>`,
      dsl: `market_summary = Scraper()
  | $("header") {
      find("h1") | clean -> "index_title"
      | find("span.timestamp", Attribute, "data-epoch") | to_int(key="epoch")
    }
  | $("table.financial-matrix") {
      table(key="stocks", header=true, normalize_headers=true, trim_cells=true)
