---
---

<div class="xsel-hero-bar">
  <div class="xsel-hero-badges">
    <span class="xsel-pill-badge xsel-pill-badge--accent">v0.6.0</span>
    <span class="xsel-pill-badge">C++20 Native</span>
    <span class="xsel-pill-badge xsel-pill-badge--green">Zero JS Runtime</span>
    <span class="xsel-pill-badge">CLI · Python · C++20 · WASM</span>
  </div>

  <div class="xsel-install-box" data-xsel-install>
    <div class="xsel-install-box__tabs" role="tablist" aria-label="Install or run commands">
      <button type="button" class="xsel-install-tab" role="tab" aria-selected="true" data-cmd="cmake --preset release && cmake --build build-release -j && ./build-release/xsel2 -d examples/product.dsl --html examples/sample.html">
        CLI (CMake)
      </button>
      <button type="button" class="xsel-install-tab" role="tab" aria-selected="false" data-cmd="pip install .   # or: uv pip install .">
        Python (scraperpy)
      </button>
      <button type="button" class="xsel-install-tab" role="tab" aria-selected="false" data-cmd="cat examples/sample.html | xsel2 -d examples/product.dsl -n summary -c">
        Stdin Pipe
      </button>
    </div>
    <div class="xsel-install-box__cmd-row">
      <div class="xsel-install-box__cmd">
        <span class="xsel-install-box__prompt">$</span>
        <span data-role="install-cmd">cmake --preset release && cmake --build build-release -j && ./build-release/xsel2 -d examples/product.dsl --html examples/sample.html</span>
      </div>
      <button type="button" class="xsel-copy-btn" data-role="install-copy">Copy</button>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-xsel-install]').forEach((box) => {
    const tabs = box.querySelectorAll('.xsel-install-tab');
    const cmdEl = box.querySelector('[data-role="install-cmd"]');
    const copyBtn = box.querySelector('[data-role="install-copy"]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-selected', 'false'));
        tab.setAttribute('aria-selected', 'true');
        cmdEl.textContent = tab.dataset.cmd || '';
      });
    });

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(cmdEl.textContent || '');
        copyBtn.textContent = 'Copied!';
        setTimeout(() => {
          copyBtn.textContent = 'Copy';
        }, 1500);
      } catch {
        // Ignore clipboard errors in restricted contexts
      }
    });
  });
</script>
