---
import CodeCard from './CodeCard.astro';

const cardHtml = `<article class="product-card">
  <h1 class="title">  Mechanical   Keyboard   Pro  </h1>
  <span class="price">$1,299.50</span>
  <img class="hero" src="/img/placeholder.png"
       data-src="/img/mk-pro.webp" />
  <a class="manual" href="/docs/mk-pro.pdf">User Manual</a>
  <dl class="specs">
    <dt>Switch</dt><dd>Tactile Brown</dd>
    <dt>Layout</dt><dd>75% Compact</dd>
  </dl>
  <script>
    window.__STATE__ = {
      sku: "MK-75", // unquoted keys & comments
      rating: 4.8,
      inStock: true,
    };
  </script>
</article>`;

const cardDsl = `let base = "https://shop.example"
product = Scraper()
  .$("article.product-card") {
    find("h1.title") | clean -> "title"
    | find(".price") | to_number(key="price")
    | find("img.hero", Attribute, ["data-src", "src"])
      | url_join(base) -> "image"
    | find("a.manual", Attribute, "href")
      | url_join(base) -> "manual_url"
    | find_all("dl.specs dt") | clean -> "_k"
    | find_all("dl.specs dd") | clean -> "_v"
    | zip_keys("_k", "_v", "specs")
    | omit_keys(["_k", "_v"])
  }
  .$("script") {
    text | js_block("window.__STATE__ =")
    | parse_js("state")
  }`;

const cardJson = `{
  "title": "Mechanical Keyboard Pro",
  "price": 1299.5,
  "image": "https://shop.example/img/mk-pro.webp",
  "manual_url": "https://shop.example/docs/mk-pro.pdf",
  "specs": {
    "Switch": "Tactile Brown",
    "Layout": "75% Compact"
  },
  "state": {
    "sku": "MK-75",
    "rating": 4.8,
    "inStock": true
  }
}`;
---

<section class="xsel-hook" aria-label="Before and after transformation">
  <div class="xsel-hook__header">
    <span class="xsel-badge">30-Second Hook</span>
    <h2>From messy real-world HTML to typed JSON in 12 lines</h2>
    <p>
      No headless browser, no fragile regex soup, no manual dict assembly.
      Extract DOM text, normalize prices &amp; URLs, zip <code>&lt;dt&gt;/&lt;dd&gt;</code> pairs,
      and parse embedded <code>&lt;script&gt;</code> state in one compiled pass.
    </p>
  </div>

  <div class="xsel-hook__grid">
    <CodeCard code={cardHtml} lang="html" dot="amber">
      <Fragment slot="title">1. Messy Input (<code>card.html</code>)</Fragment>
    </CodeCard>

    <CodeCard code={cardDsl} lang="xsel2" dot="blue" variant="accent">
      <Fragment slot="title">2. <code>xsel2</code> DSL (<code>product.dsl</code>)</Fragment>
    </CodeCard>

    <CodeCard code={cardJson} lang="json" dot="green" variant="out">
      <Fragment slot="title">3. Typed JSON Output</Fragment>
    </CodeCard>
  </div>

  <div class="xsel-hook__cta-row">
    <a href="#try-xsel2-live-in-webassembly" class="xsel-inline-link">
      Edit &amp; run this exact pipeline in the live WASM playground below &darr;
    </a>
  </div>
</section>

<section class="xsel-pillars" aria-label="Why xsel2">
  <div class="xsel-pillar">
    <div class="xsel-pillar__top">
      <svg class="xsel-pillar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/>
      </svg>
      <span class="xsel-pillar__kicker">Zero JS Runtime</span>
    </div>
    <h3>Deterministic Script Extraction</h3>
    <p>
      Heuristically extracts and parses embedded JS/JSON objects—comments, unquoted keys,
      trailing commas, and string concatenations—without spinning up V8 or a browser.
    </p>
  </div>
  <div class="xsel-pillar">
    <div class="xsel-pillar__top">
      <svg class="xsel-pillar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
      </svg>
      <span class="xsel-pillar__kicker">C++20 Native Core</span>
    </div>
    <h3>Built for Throughput</h3>
    <p>
      Backed by <code>libxml2</code>, Google <code>RE2</code>, compressed-DFA Aho-Corasick,
      and <code>jsoncons</code>, with multi-threaded <code>--batch</code> NDJSON streaming.
    </p>
  </div>
  <div class="xsel-pillar">
    <div class="xsel-pillar__top">
      <svg class="xsel-pillar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l3 3-3 3M13 15h4"/>
      </svg>
      <span class="xsel-pillar__kicker">Write Once</span>
    </div>
    <h3>CLI, Python, C++20 &amp; WASM</h3>
    <p>
      Author pipelines in the <code>xsel2</code> DSL (<code>.dsl</code>) or fluent builders and run the exact same engine
      from the terminal, <code>scraperpy</code>, embedded C++, or the browser.
    </p>
  </div>
  <div class="xsel-pillar">
    <div class="xsel-pillar__top">
      <svg class="xsel-pillar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M12 2l3 7h7l-5.5 4.5 2 7L12 16l-6.5 4.5 2-7L2 9h7l3-7z"/>
      </svg>
      <span class="xsel-pillar__kicker">Batteries Included</span>
    </div>
    <h3>End-to-End Shaping</h3>
    <p>
      CSS, XPath 1.0, RFC 3986 URLs, <code>absl::Time</code> dates, <code>utf8proc</code> Unicode,
      fuzzy matching, JMESPath, JSONPath, and JSON Schema validation.
    </p>
  </div>
</section>

<section class="xsel-flow" aria-label="Pipeline architecture">
  <a href="/xsel2/dsl/mental-model/#pipeline-architecture" class="xsel-flow__step">
    <span class="xsel-flow__num">01</span>
    <strong>Ingest</strong>
    <span>HTML, XML, JSON, CSV, or stdin stream</span>
  </a>
  <div class="xsel-flow__arrow" aria-hidden="true">&rarr;</div>
  <a href="/xsel2/dsl/steps-reference/#dom--selection" class="xsel-flow__step">
    <span class="xsel-flow__num">02</span>
    <strong>Select</strong>
    <span>CSS, XPath 1.0, or <code>js_block</code></span>
  </a>
  <div class="xsel-flow__arrow" aria-hidden="true">&rarr;</div>
  <a href="/xsel2/dsl/steps-reference/#regex-aho-corasick--filtering" class="xsel-flow__step">
    <span class="xsel-flow__num">03</span>
    <strong>Transform</strong>
    <span>RE2, Aho-Corasick, URL, Date, Fuzzy</span>
  </a>
  <div class="xsel-flow__arrow" aria-hidden="true">&rarr;</div>
  <a href="/xsel2/dsl/steps-reference/#dictionary-typed-casting-jsoncsv--query-steps" class="xsel-flow__step">
    <span class="xsel-flow__num">04</span>
    <strong>Shape &amp; Emit</strong>
    <span>JMESPath, JSON Schema, Typed JSON / NDJSON</span>
  </a>
</section>
