{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "xsel2",
  "scopeName": "source.xsel2",
  "aliases": ["dsl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.xsel2",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.xsel2",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.xsel2",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.xsel2",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#interpolation" }
          ]
        },
        {
          "name": "string.quoted.single.xsel2",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#interpolation" }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.xsel2",
          "match": "\\\\."
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.line.xsel2",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.xsel2" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.xsel2" }
          },
          "patterns": [
            {
              "name": "variable.other.xsel2",
              "match": "[a-zA-Z_][a-zA-Z0-9_]*"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.xsel2",
          "match": "\\b(let|pipe|use|include|finalize|tee|branch|each|when_exists|unless_exists|when_match|skip_if_exists|skip_if_empty|abort_if_exists|as)\\b"
        },
        {
          "name": "constant.language.xsel2",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.xsel2",
          "match": "\\b(Scraper|ScraperPy|Value|InsertMode|Text|OwnText|Attribute|ElementExists|AttributeExists|Adjacent|Default|Overwrite|AppendToList|UniqueSuffix|Merge)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.xsel2",
          "match": "\\b-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.xsel2",
          "match": "(->|>>|\\?\\?|:=|\\||\\$|@)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.xsel2",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    }
  }
}
