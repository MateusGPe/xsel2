from enum import Enum
from typing import Any, Dict, List, Optional, Tuple

__version__: str

class Value(Enum):
    Text = ...
    OwnText = ...
    Attribute = ...
    ElementExists = ...
    AttributeExists = ...
    Adjacent = ...

class Number(Enum):
    All = ...
    Last = ...
    Nth = ...

class InsertMode(Enum):
    Default = ...
    Overwrite = ...
    AppendToList = ...
    UniqueSuffix = ...
    Merge = ...

class InsertOptions:
    mode: InsertMode
    allow_empty: bool
    nested_path: bool
    def __init__(self) -> None: ...

class AhoCorasick:
    def __init__(self) -> None: ...
    def add_pattern(self, pattern: str) -> int: ...
    def build(self) -> None: ...
    def contains_any(self, text: str) -> bool: ...
    def search(self, text: str) -> List[Tuple[int, int, str, int]]: ...

class ScraperPy:
    def __init__(self) -> None: ...
    def from_string(self, content: str) -> Any: ...
    def from_file(self, filename: str) -> Any: ...
    def push(self, selector: str, key: str = "") -> ScraperPy: ...
    def text(self, own_text: bool = False) -> ScraperPy: ...
    def attr(self, attr_name: str) -> ScraperPy: ...
    def query_all(self, sel: str, type: Value, attr: str = "") -> ScraperPy: ...
    def query(
        self,
        sel: str,
        type: Value,
        attr: str = "",
        number: Number = Number.All,
        nth_val: int = 0,
    ) -> ScraperPy: ...
    def trim(self) -> ScraperPy: ...
    def strip(self) -> ScraperPy: ...
    def normspace(self) -> ScraperPy: ...
    def lower(self) -> ScraperPy: ...
    def upper(self) -> ScraperPy: ...
    def unescape(self, url_decode: bool = True) -> ScraperPy: ...
    def replace(self, from_str: str, to_str: str = "") -> ScraperPy: ...
    def substitute(self, from_str: str, to_str: str = "") -> ScraperPy: ...
    def split(self, delimiter: str, keep_empty_parts: bool = False) -> ScraperPy: ...
    def join(self, delimiter: str) -> ScraperPy: ...
    def prepend(self, prefix_str: str) -> ScraperPy: ...
    def append(self, suffix_str: str) -> ScraperPy: ...
    def remove_empty(self, also_trim: bool = True) -> ScraperPy: ...
    def substring(self, start_pos: int, length: Optional[int] = None) -> ScraperPy: ...
    def strip_comments(self, multiline: bool = True, single_line: bool = True) -> ScraperPy: ...
    def regex_replace(self, pattern: str, replacement: str, flags: Optional[str] = None) -> ScraperPy: ...
    def regex_filter(self, pattern: str, negate: bool = False, flags: Optional[str] = None) -> ScraperPy: ...
    def regex_extract(self, pattern: str, group_index: int = 0, flags: Optional[str] = None) -> ScraperPy: ...
    def filter(self, patterns: List[str]) -> ScraperPy: ...
    def set(self, name: str, opts: InsertOptions = ...) -> ScraperPy: ...
    def count_values(self, dict_key: str, opts: InsertOptions = ...) -> ScraperPy: ...
    def first(self, count: int = 1) -> ScraperPy: ...
    def last(self, count: int = 1) -> ScraperPy: ...
    def nth(self, index: int) -> ScraperPy: ...
    def slice_values(self, start_index: int, end_index_inclusive: int) -> ScraperPy: ...
    def unique(self, preserve_order: bool = True) -> ScraperPy: ...
    def default_if_empty(self, default_value: str) -> ScraperPy: ...
    def block_seeker(self, prefix: str = "") -> ScraperPy: ...
    def block_parser(self, prefixes: List[str]) -> ScraperPy: ...
    def parse(self, objname: str, simplify: bool = True, opts: InsertOptions = ...) -> ScraperPy: ...
    def flatten_dict(self, postponable: bool = True) -> ScraperPy: ...
    def flatten_local(self) -> ScraperPy: ...
    def filter_dict(self, keys_to_keep: List[str], postponable: bool = True) -> ScraperPy: ...
    def remove_keys(self, keys_to_remove: List[str], postponable: bool = True) -> ScraperPy: ...
    def sort_keys(self, ascending: bool = True, postponable: bool = True) -> ScraperPy: ...
    def deduplicate(self, postponable: bool = True) -> ScraperPy: ...
    def jmespath(self, expr: str, postponable: bool = True) -> ScraperPy: ...
    def jsonpath(self, expr: str, postponable: bool = True) -> ScraperPy: ...

def jmespath_eval(data: Any, expr: str) -> Any: ...
def jsonpath_query(data: Any, expr: str) -> Any: ...
def parse_dsl_string(dsl_content: str) -> Dict[str, ScraperPy]: ...
